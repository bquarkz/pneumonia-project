# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is gitignored; this file is the only one that should be committed.

# --- Postgres ---
POSTGRES_DB=pneumonia
POSTGRES_USER=pneumonia
POSTGRES_PASSWORD=changeme

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=pneumonia
RABBITMQ_DEFAULT_PASS=changeme

# --- Keycloak ---
# Bootstrap admin account for the Keycloak admin console (dev-mode only).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme
# Keycloak persists to its own database on the same Postgres instance the backend uses (not
# the shared postgres/pneumonia credentials - a separate role, scoped to only this database).
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changeme
# Issuer URI as seen by the backend container (service-to-service, inside the compose network).
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/pneumonia
# Base URL as seen by the browser (frontend login redirects, Keycloak JS adapter).
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# --- Google Identity Provider (federated login via Keycloak) ---
# Left empty on purpose: Keycloak comes up with only the static fallback user until you
# run the walkthrough in scripts/configure-google-idp.md. Fill these in after that, then
# re-run the walkthrough's last step (or re-apply the IdP config) to pick them up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
XRAY_STORAGE_DIR=/data/xrays
ML_SERVICE_URL=http://ml-service:8000

# --- Frontend ---
# Backend base URL as seen by the browser.
BACKEND_PUBLIC_URL=http://localhost:8081
